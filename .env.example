# XiansAi Community Edition - User Configuration
# Copy this file to .env, set your values below, then run ./start-all.sh
# (which calls scripts/create-secrets.sh to generate the per-service secrets).

# ====================
# REQUIRED
# ====================

# Email address of the first platform administrator (SysAdmin).
# Used by the server bootstrap step to mint your first API key AND as the
# Agent Studio login username. If left empty, start-all.sh will prompt for it.
ADMIN_EMAIL=

# Password for the Agent Studio local login (paired with ADMIN_EMAIL).
# If left empty, start-all.sh will prompt for one (or generate and print it).
ADMIN_PASSWORD=

# ====================
# AGENT STUDIO SIGN-IN
# ====================
# By default the Community Edition uses Agent Studio's built-in local login:
# you sign in with ADMIN_EMAIL / ADMIN_PASSWORD — no external provider required.
#
# The OAuth/OIDC providers below are OPTIONAL. Fill in one provider's
# credentials only if you prefer SSO; they are copied into studio/.env.local
# automatically. You can also edit studio/.env.local later and restart Studio.

# Google - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft / Azure AD
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Visma Connect - https://oauth.developers.visma.com
VISMA_CONNECT_CLIENT_ID=
VISMA_CONNECT_ISSUER=

# ====================
# OPTIONAL
# ====================
# Azure Application Insights connection string used by otel-collector
# when started with: ./start-all.sh --observability-azure
APPLICATIONINSIGHTS_CONNECTION_STRING=
