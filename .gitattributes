# Normalise everything to LF in the repository.
#
# This matters on Windows: mongodb/mongo-startup.sh is bind-mounted straight
# into a Linux container, and CRLF line endings make its shebang unusable.
* text eol=lf

# PowerShell wrappers are Windows-only entry points; keep them CRLF in the
# working tree, which is what Windows editors and tooling expect.
*.ps1 text eol=crlf
