# Agent Studio Environment Configuration
# Copy this file to .env.local - secrets and the API key are auto-populated by
# create-secrets.sh and start-all.sh (bootstrap step).

# ======================
# Node Environment
# ======================
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ======================
# Xians API Configuration
# ======================
# XIANS_APIKEY is minted by the server bootstrap step and written here
# automatically by start-all.sh. Leave empty for a fresh install.
XIANS_APIKEY=
# Server URL as reached from inside the Docker network (service name).
XIANS_SERVER_URL=http://xiansai-server:8080

# ======================
# NextAuth Configuration
# ======================
# NEXTAUTH_URL must match the URL you open in the browser.
NEXTAUTH_URL=http://localhost:3000
# Auto-generated by create-secrets.sh (openssl rand -base64 32).
NEXTAUTH_SECRET=

# ======================
# Local login (default for the Community Edition)
# ======================
# Agent Studio provides a simple email/password login for local deployments,
# so no external OAuth provider is required. start-all.sh enables this and
# populates LOCAL_AUTH_USERS with your bootstrap admin (ADMIN_EMAIL:ADMIN_PASSWORD).
#
# LOCAL_AUTH_USERS is a comma-separated list of email:password pairs. Each email
# must be a Xians participant with tenant access (the bootstrap admin is).
#
# IMPORTANT: this is for local/evaluation use only — never enable it on a
# publicly reachable deployment.
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_USERS=

# ======================
# OAuth/OIDC providers (OPTIONAL — alternative to local login)
# ======================
# Configure any of these if you prefer SSO. Set the credentials in the ROOT .env
# file and they are copied here automatically, or set them directly below and
# restart Agent Studio. Sign in with an identity whose email matches ADMIN_EMAIL.

# Google - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft / Azure AD - use "organizations" or "common" for multi-tenant apps
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Visma Connect - https://oauth.developers.visma.com
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/visma-connect
VISMA_CONNECT_CLIENT_ID=
VISMA_CONNECT_ISSUER=
