# Temporal Environment Configuration
# This file contains the environment variables used by Temporal services
# Copy this file to .env.local - secrets will be auto-generated

# =============================================================================
# Temporal Versions
# =============================================================================
# Specify the Temporal Docker image versions to use.
# TEMPORAL_VERSION is used for both temporalio/server and temporalio/admin-tools
# (they are released together). Schema migrations run automatically on upgrade.
TEMPORAL_VERSION=1.32.0
TEMPORAL_UI_VERSION=2.54.1

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=
